doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= title
    link(rel='stylesheet' href='/css/style.css')
  body
    main
      a(href='/update-cobj') Add to this table
      h1 Plants
      .table-wrap
        table
          thead
            tr
              th(scope='col') Name
              th(scope='col') Species
              th(scope='col') Watering frequency
          tbody
            if !plants.length
              tr
                td(colspan='3') No plants yet. Add your first plant.
            each plant in plants
              tr
                td= plant.properties.name
                td= plant.properties.species
                td= plant.properties.watering_frequency
